{
  "name": "pi-jev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Pi extension for task-scoped Jev tool-call decisions.",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run evaluate:offline && npm run smoke:pi",
    "evaluate:offline": "node --import tsx scripts/evaluate.ts",
    "evaluate:live": "node --import tsx scripts/evaluate.ts --live",
    "smoke:pi": "node --import tsx scripts/smoke-pi.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "tsx": "^4.20.3"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "jev"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}

# Export these in the shell that launches Pi; this file is not loaded automatically.
OPENROUTER_API_KEY=replace-me
# Required for automatic Jev approvals. Describe the authorized task narrowly.
PI_JEV_TASK=Run local tests and inspect repository status
# Optional; defaults to typesafe/jev-1.13
JEV_MODEL=typesafe/jev-1.13
